format_version: "11"
project_type: android

trigger_map:
  - push_branch: "*"
    workflow: build_apk

workflows:
  build_apk:
    steps:
      - script@1:
          title: Build NEXVIA APK
          inputs:
            - content: |
                #!/usr/bin/env bash
                set -euo pipefail
                GRADLE_VERSION="8.9"
                GRADLE_DIR="/tmp/gradle-${GRADLE_VERSION}"
                GRADLE_ZIP="/tmp/gradle-${GRADLE_VERSION}-bin.zip"
                curl -fsSL --retry 5 --retry-delay 2 "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "${GRADLE_ZIP}"
                rm -rf "${GRADLE_DIR}"
                mkdir -p "${GRADLE_DIR}"
                unzip -q "${GRADLE_ZIP}" -d "${GRADLE_DIR}"
                GRADLE_BIN="${GRADLE_DIR}/gradle-${GRADLE_VERSION}/bin/gradle"
                chmod +x "${GRADLE_BIN}"
                "${GRADLE_BIN}" --version
                "${GRADLE_BIN}" --no-daemon --stacktrace :app:assembleDebug
                APK_PATH="app/build/outputs/apk/debug/app-debug.apk"
                test -f "${APK_PATH}"
      - deploy-to-bitrise-io@2:
          inputs:
            - deploy_path_list: app/build/outputs/apk/debug/app-debug.apk

plugins {
    id("com.android.application") version "8.7.3" apply false
    id("org.jetbrains.kotlin.android") version "2.0.21" apply false
    id("org.jetbrains.kotlin.plugin.compose") version "2.0.21" apply false
}

org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.useAndroidX=true
kotlin.code.style=official

#!/usr/bin/env sh
# Bitrise build uses the self-contained workflow script and does not invoke this wrapper.
# This launcher is kept only so Android project scanners recognize the repository.
echo "NEXVIA: Bitrise workflow uses its pinned Gradle 8.9 installation." >&2
exit 1

# NEXVIA Android — Starter

این نسخه، اسکلت اولیه اپ NEXVIA است:
- صفحه ورود کد/رمز
- داشبورد
- دکمه اتصال نمایشی (فعلاً VPN واقعی وصل نمی‌کند)
- برند NEXVIA
- Designed by Mehooodi

## اجرا
1. Android Studio را نصب کن.
2. این پوشه را Open کن.
3. اجازه بده Gradle dependencies را دریافت کند.
4. یک Android Emulator یا گوشی واقعی انتخاب کن.
5. Run را بزن.

## مرحله بعد
بعد از آماده شدن VPS، بخش اتصال واقعی WireGuard/VPN و API احراز هویت به همین پروژه اضافه می‌شود.

# NEXVIA — Bitrise build package

This package is prepared for Bitrise. The Bitrise workflow deliberately does **not** depend on `gradle-wrapper.jar`.
Instead, the workflow downloads the pinned Gradle 8.9 distribution and runs `:app:assembleDebug`, then uploads `app-debug.apk` to Bitrise Artifacts.

## What to do

1. Replace the files in your GitHub repository with the contents of this folder.
2. In Bitrise, use the `build_apk` workflow.
3. Run the build.
4. Download `app-debug.apk` from the Artifacts tab.

The workflow also contains a push trigger for all branches.

Note: this APK is still the NEXVIA starter app. The VPN button is a UI demo; real WireGuard/API connectivity has not yet been added.

